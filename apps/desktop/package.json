{
  "name": "@app/desktop",
  "version": "0.1.0",
  "author": "erniu",
  "private": true,
  "description": "久坐提醒桌面端（Tauri 2 + React）",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/generate-icons.mjs && node scripts/make-ico.mjs && node scripts/sync-icons.mjs",
    "sync-icons": "node scripts/sync-icons.mjs",
    "build:win": "node scripts/make-ico.mjs && node scripts/sync-icons.mjs && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "chinese-days": "^1.5.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@app/core": "workspace:*",
    "@app/schema": "workspace:*",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
